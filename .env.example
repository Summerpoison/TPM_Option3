# Copy to .env and fill in. .env is gitignored — never commit it.
PAULSJOB_API_KEY=your_api_key_here
PAULSJOB_BASE_URL=https://api.paulsjob.ai/dev/v1

# Optional. Person slug to own the seeded jobs. If unset, the seeder reuses an
# existing employee or creates one, because a company API key has no person
# behind it and a job needs an owner before its pipeline can be initialised.
PAULSJOB_JOB_OWNER_SLUG=

# Optional. Pipeline template to initialise seeded jobs with. If unset, the
# seeder asks the API to auto-select, which requires a company default template.
PAULSJOB_PIPELINE_TEMPLATE_ID=
